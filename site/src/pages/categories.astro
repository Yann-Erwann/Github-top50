---
import PeriodFilter from "../components/PeriodFilter.astro";
import RepositoryList from "../components/RepositoryList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData } from "../data/site-data";

const data = await getSiteData();
const defaultPeriod = data.periods.find((period) => period.available)?.id ?? null;
const categoriesStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Categories techniques des repositories GitHub populaires",
  description:
    "Panorama SEO des repositories GitHub classes par stack, langage, discipline frontend, backend, DevOps, data et intelligence artificielle.",
  numberOfItems: data.categories.length,
  itemListElement: data.categories.map((category, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: category.title,
    description: category.description ?? undefined
  }))
};
---

<BaseLayout
  title="Repositories GitHub par catégorie"
  description="Comparez les repositories GitHub populaires par stack technique: frontend, backend, DevOps, data, IA, langages et outils open source."
  currentPath="/categories/"
  pageType="CollectionPage"
  structuredData={categoriesStructuredData}
>
  <section class="page-hero page-hero-tight">
    <div>
      <p class="eyebrow">Category map</p>
      <h1>Un panorama par domaines techniques</h1>
      <p class="page-intro">
        Chaque catégorie expose son top dédié, avec un angle de lecture lisible pour détecter les
        signaux forts par stack, pratique ou discipline d’ingénierie.
      </p>
    </div>
  </section>

  <section class="section-block">
    <nav class="category-rail" aria-label="Accès rapide aux catégories">
      {
        data.categories.map((category) => (
          <a class:list={["category-chip", `accent-${category.accent ?? "aurora"}`]} href={`#${category.tag.toLowerCase()}`}>
            {category.title}
          </a>
        ))
      }
    </nav>
    <PeriodFilter periods={data.periods} defaultPeriod={defaultPeriod} />
  </section>

  <section class="category-sections">
    {
      data.categories.map((category) => (
        <article id={category.tag.toLowerCase()} class="category-section card-surface">
          <div class="section-heading">
            <p class="eyebrow">{category.tag}</p>
            <h2>{category.title}</h2>
            <p>{category.description}</p>
          </div>
          <RepositoryList
            items={category.items}
            compact={true}
            defaultPeriod={defaultPeriod}
          />
        </article>
      ))
    }
  </section>
</BaseLayout>
