---
import HostingGrid from "../components/HostingGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData } from "../data/site-data";

const data = await getSiteData();
const hostingStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Recommandations d'hebergement pour stacks populaires",
  description:
    "Comparatif des solutions d'hebergement adaptees aux stacks frontend, backend et services conteneurises observes dans les repositories GitHub populaires.",
  numberOfItems: data.hosting.length,
  itemListElement: data.hosting.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${item.stack} sur ${item.hosting}`,
    url: item.url,
    description: item.notes
  }))
};
---

<BaseLayout
  title="Hébergement pour stacks GitHub"
  description="Trouvez une solution d’hébergement adaptée aux stacks GitHub populaires: Vercel, Render, services Docker, previews et démos rapides."
  currentPath="/hosting/"
  pageType="CollectionPage"
  structuredData={hostingStructuredData}
>
  <section class="page-hero page-hero-tight">
    <div>
      <p class="eyebrow">Hosting matrix</p>
      <h1>Des recommandations simples pour lancer vite</h1>
      <p class="page-intro">
        Cette page synthétise les choix d’hébergement les plus pragmatiques pour des environnements
        de test, de démo et de validation rapide, sans transformer le site en catalogue d’infra.
      </p>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Options par stack</p>
      <h2>Matrice des hébergements</h2>
    </div>
    <HostingGrid items={data.hosting} />
  </section>
</BaseLayout>
