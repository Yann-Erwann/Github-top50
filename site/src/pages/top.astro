---
import PeriodFilter from "../components/PeriodFilter.astro";
import RepositoryList from "../components/RepositoryList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData } from "../data/site-data";
import { formatInteger } from "../utils/format";

const data = await getSiteData();
const defaultPeriod = data.periods.find((period) => period.available)?.id ?? null;
const topRepositoriesStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Top 50 repositories GitHub par nombre de stars",
  description:
    "Classement des 50 repositories GitHub les plus suivis, trie par nombre de stars et enrichi avec langage, description et mouvement de rang.",
  numberOfItems: data.global.items.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: data.global.items.map((item) => ({
    "@type": "ListItem",
    position: item.rank,
    name: item.fullName,
    url: item.htmlUrl,
    description: item.description ?? undefined
  }))
};
---

<BaseLayout
  title="Classement GitHub Stars"
  description="Consultez le top 50 des repositories GitHub les plus étoilés avec rang, stars, langage principal et signaux de popularité open source."
  currentPath="/top/"
  pageType="CollectionPage"
  structuredData={topRepositoriesStructuredData}
>
  <section class="page-hero page-hero-tight">
    <div>
      <p class="eyebrow">Top 50 global</p>
      <h1>Classement principal des repositories GitHub</h1>
      <p class="page-intro">
        Explore le classement principal et repère les repositories les plus visibles du snapshot.
      </p>
    </div>
    <div class="page-hero-side card-surface">
      <p class="card-kicker">Volume analysé</p>
      <p class="hero-side-value">{formatInteger(data.global.items.length)}</p>
      <p class="hero-side-copy">repositories visibles dans le top global.</p>
    </div>
  </section>

  <section class="section-block">
    <PeriodFilter periods={data.periods} defaultPeriod={defaultPeriod} />
    <RepositoryList items={data.global.items} defaultPeriod={defaultPeriod} />
  </section>
</BaseLayout>
