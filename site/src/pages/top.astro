---
import PeriodFilter from "../components/PeriodFilter.astro";
import RepositoryList from "../components/RepositoryList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData, sortRepositoriesByPeriod } from "../data/site-data";
import { formatInteger } from "../utils/format";

const data = await getSiteData();
const defaultPeriod = data.periods.find((period) => period.available)?.id ?? null;
const defaultPeriodRepositories = sortRepositoriesByPeriod(data.global.items, defaultPeriod);
const topRepositoriesStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Top 50 repositories GitHub suivis par étoiles reçues sur la période",
  description:
    "Classement des repositories GitHub suivis selon le total d'étoiles reçues sur la période sélectionnée, avec langage, description et total historique GitHub.",
  numberOfItems: data.global.items.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: defaultPeriodRepositories.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.fullName,
    url: item.htmlUrl,
    description: item.description ?? undefined
  }))
};
---

<BaseLayout
  title="Classement GitHub Stars"
  description="Consultez les repositories GitHub suivis classés par total d’étoiles reçues sur la période sélectionnée, avec rang, total historique GitHub et langage principal."
  currentPath="/top/"
  pageType="CollectionPage"
  structuredData={topRepositoriesStructuredData}
>
  <section class="page-hero page-hero-tight">
    <div>
      <p class="eyebrow">Top 50 global</p>
      <h1>Classement principal des repositories GitHub</h1>
      <p class="page-intro">
        Sélectionne une période pour classer les repositories suivis selon le total d’étoiles
        reçues depuis le snapshot de référence.
      </p>
    </div>
    <div class="page-hero-side card-surface">
      <p class="card-kicker">Volume analysé</p>
      <p class="hero-side-value">{formatInteger(data.global.items.length)}</p>
      <p class="hero-side-copy">repositories visibles dans le top global.</p>
    </div>
  </section>

  <section class="section-block">
    <PeriodFilter periods={data.periods} defaultPeriod={defaultPeriod} />
    <RepositoryList items={data.global.items} defaultPeriod={defaultPeriod} />
  </section>
</BaseLayout>
