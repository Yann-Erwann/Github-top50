---
import RepositoryList from "../components/RepositoryList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData } from "../data/site-data";
import { formatInteger } from "../utils/format";

const data = await getSiteData();
---

<BaseLayout
  title="Top stars"
  description="Le top 50 GitHub Stars."
  currentPath="/top/"
>
  <section class="page-hero page-hero-tight">
    <div>
      <p class="eyebrow">Top 50 global</p>
      <h1>Classement principal des repositories GitHub</h1>
      <p class="page-intro">
        Explore le classement principal et repère les repositories les plus visibles du snapshot.
      </p>
    </div>
    <div class="page-hero-side card-surface">
      <p class="card-kicker">Volume analysé</p>
      <p class="hero-side-value">{formatInteger(data.global.items.length)}</p>
      <p class="hero-side-copy">repositories visibles dans le top global.</p>
    </div>
  </section>

  <section class="section-block">
    <RepositoryList items={data.global.items} />
  </section>
</BaseLayout>
