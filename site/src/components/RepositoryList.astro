---
import { sortRepositoriesByPeriod, type RepositoryEntry } from "../data/site-data";
import { formatCompactNumber, formatStarsGained, formatInteger } from "../utils/format";

interface Props {
  items: RepositoryEntry[];
  id?: string;
  compact?: boolean;
  defaultPeriod?: string | null;
  limit?: number | null;
}

const { items, id, compact = false, defaultPeriod = null, limit = null } = Astro.props;
const visibleItems = sortRepositoriesByPeriod(items, defaultPeriod);
---

<div class:list={["repo-list-shell", compact && "is-compact"]}>
  <div class="repo-list-head" aria-hidden="true">
    <span data-period-rank-heading>Rank</span>
    <span data-period-column-heading>Gagnés</span>
    <span>Repository</span>
    <span>Langage</span>
    <span>Stars</span>
  </div>

  <div id={id} class="repo-list" data-repo-list data-max-items={limit}>
    {
      visibleItems.map((item, index) => {
        const periodRanking =
          defaultPeriod &&
          Object.prototype.hasOwnProperty.call(item.periodRankings, defaultPeriod)
            ? item.periodRankings[defaultPeriod]
            : null;
        const periodStarsGained =
          defaultPeriod &&
          Object.prototype.hasOwnProperty.call(item.periodStarsGained, defaultPeriod)
            ? item.periodStarsGained[defaultPeriod]
            : null;
        const starsGained = formatStarsGained(periodStarsGained);
        const [owner, repositoryName] = item.fullName.split("/");

        return (
          <article
            class="repo-row"
            data-repo-row
            data-current-rank={item.rank}
            data-period-rankings={JSON.stringify(item.periodRankings)}
            data-period-stars-gained={JSON.stringify(item.periodStarsGained)}
            hidden={limit !== null && index >= limit}
          >
            <div class="repo-rank" data-period-rank>
              {periodRanking === null ? "#—" : `#${formatInteger(periodRanking)}`}
            </div>
            <div
              class:list={["movement-pill", `movement-${starsGained.tone}`]}
              data-stars-gained
              aria-label={`Étoiles gagnées: ${starsGained.label}`}
            >
              {starsGained.label}
            </div>
            <div class="repo-main">
              <a class="repo-link" href={item.htmlUrl}>
                <span class="repo-owner">{owner}</span>
                <span class="repo-separator">/</span>
                <span class="repo-name">{repositoryName}</span>
              </a>
              <p class="repo-description">{item.description ?? "Aucune description fournie."}</p>
            </div>
            <div class="repo-language">
              <span class="language-pill">{item.language ?? "Mixte"}</span>
            </div>
            <div class="repo-stars" aria-label={`${formatInteger(item.stargazersCount)} étoiles`}>
              {compact ? formatCompactNumber(item.stargazersCount) : formatInteger(item.stargazersCount)}
            </div>
          </article>
        );
      })
    }
  </div>
</div>
