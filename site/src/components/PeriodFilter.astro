---
import type { PeriodOption } from "../data/site-data";
import { formatSnapshotDate } from "../utils/format";

interface Props {
  periods: PeriodOption[];
  defaultPeriod?: string | null;
  trackedRepositoriesOnly?: boolean;
}

const {
  periods,
  defaultPeriod = null,
  trackedRepositoriesOnly = false
} = Astro.props;
const availablePeriods = periods.filter((period) => period.available);
const selectedPeriod = defaultPeriod ?? availablePeriods[0]?.id ?? "";
const selectedPeriodOption = periods.find((period) => period.id === selectedPeriod);
const formatPeriodContext = (period: PeriodOption | undefined) => {
  if (trackedRepositoriesOnly) {
    return period?.baselineCapturedAt
      ? `Repositories suivis · référence ${formatSnapshotDate(period.baselineCapturedAt)}`
      : "Historique indisponible";
  }
  if (period?.rankingMode === "created" && period.startsAt) {
    return `Repositories créés depuis ${formatSnapshotDate(period.startsAt)}`;
  }
  if (period?.rankingMode === "all") {
    return "Tous les repositories";
  }
  return period?.baselineCapturedAt
    ? `Référence ${formatSnapshotDate(period.baselineCapturedAt)}`
    : "Historique indisponible";
};
const selectedBaselineLabel = formatPeriodContext(selectedPeriodOption);
---

{
  periods.length > 0 && (
    <div
      class="period-filter"
      data-period-filter
      data-default-period={selectedPeriod}
    >
      <div class="period-filter-copy">
        <span class="period-filter-label">Comparaison</span>
        <p class="period-filter-status" data-period-status aria-live="polite">
          {selectedPeriodOption
            ? `Classement par total d'étoiles reçues · ${selectedPeriodOption.label} · ${selectedBaselineLabel}`
            : `Classement par total d'étoiles reçues · ${selectedBaselineLabel}`}
        </p>
      </div>
      <div class="period-options" role="radiogroup" aria-label="Période de comparaison">
        {periods.map((period) => {
          const isSelected = period.available && period.id === selectedPeriod;
          const baselineLabel = formatPeriodContext(period);

          return (
            <button
              class:list={["period-button", isSelected && "is-active"]}
              type="button"
              role="radio"
              aria-checked={String(isSelected)}
              aria-label={`${period.label}. ${baselineLabel}.`}
              data-period-button
              data-period-id={period.id}
              data-period-label={period.label}
              data-baseline-label={baselineLabel}
              disabled={!period.available}
              title={baselineLabel}
            >
              {period.label}
            </button>
          );
        })}
      </div>
    </div>
  )
}
